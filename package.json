{
  "name": "feedback-nexus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:docs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run src && npm run test:docs",
    "test:e2e": "playwright test",
    "build:docs": "node scripts/build-docs.mjs",
    "test:docs": "node --test scripts/build-docs.test.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "^9.39.0",
    "github-slugger": "2.0.0",
    "globals": "^16.5.0",
    "markdown-it": "15.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
